# --- Version Control & IDEs ---
.git/
.github/
**/.git
**/.gitignore
**/.gitattributes
**/.vscode
**/.idea
**/.DS_Store
.editorconfig

# --- Documentation & Meta ---
LICENSE
README.md
.env.example

# --- Docker & Orchestration configs ---
**/.dockerignore
**/Dockerfile*
**/compose*.y*ml
**/docker-compose*

# --- PHP/Laravel Runtime & Caches ---
vendor/
.phpunit.result.cache
phpunit.xml
phpunit.xml.dist
tests/

storage/framework/cache/*
!storage/framework/cache/.gitignore
storage/framework/sessions/*
!storage/framework/sessions/.gitignore
storage/framework/views/*
!storage/framework/views/.gitignore
storage/logs/*
!storage/logs/.gitignore
bootstrap/cache/*
!bootstrap/cache/.gitignore

# --- Node/Frontend Build Caches ---
node_modules/
public/hot
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Environment Files Protection ---
.env
.env.*
!.env.example.*
