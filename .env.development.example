APP_NAME=ProposalKit
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

LIVE_DEMO_ENABLED=false

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=proposalkit
DB_USERNAME=laravel
DB_PASSWORD=secret

QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Host ports published by the db and redis containers. Change them if
# MySQL or Redis already run on your machine (inside Docker nothing changes).
# DB_FORWARD_PORT=3307
# REDIS_FORWARD_PORT=6380

# Sync user ID and group ID to avoid permission issues on development
UID=1000  # Replace with your user ID
GID=1000  # Replace with your group ID
